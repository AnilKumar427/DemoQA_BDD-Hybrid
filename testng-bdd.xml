<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="DemoQA BDD Suite" verbose="1">
    <parameter name="browser" value="edge" />
    <parameter name="executionType" value="BDD" />

    <listeners>
        <listener class-name="com.demoqa.listeners.TestListener" />
    </listeners>

    <test name="BDD Component Tests">
        <classes>
            <class name="com.demoqa.runners.TestRunner"/>
        </classes>
    </test>
</suite>